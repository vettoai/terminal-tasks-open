{
  "name": "contract-workspace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*"],
  "scripts": {
    "db:start": "bash scripts/postgres.sh",
    "db:shell": "PGPASSWORD=contracts-local psql -h 127.0.0.1 -U contracts -d contracts",
    "dev": "vite --host 0.0.0.0",
